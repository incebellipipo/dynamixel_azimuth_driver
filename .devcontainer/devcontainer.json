{
    "image": "incebellipipo/devcontainer:rolling",
    "customizations": {
        "terminalPrompt": "🐳 [container] ${containerName} ${folder}",
        "settings": {
            "terminal.integrated.shell.linux": "/bin/bash"
        },
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "ms-python.python",
                "ms-python.debugpy",
                "twxs.cmake"
            ]
        }
    },
    "workspaceFolder": "/home/developer/src",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/developer/src,type=bind",
    "privileged": true,
    "containerEnv": {
        "DISPLAY": "unix:0"
    },
    "runArgs": [
        "--net=host",
        "-e", "DISPLAY=${env:DISPLAY}"
    ],
    "mounts": [
        // "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
        "source=/dev,target=/dev,type=bind,consistency=cached"
    ],
    "postAttachCommand": ["/bin/bash", "-c", "source /opt/ros/rolling/setup.bash"],
    "postCreateCommand": ["/bin/bash", "-c", "rosdep update && rosdep install --from-paths ~ --ignore-src -y"]
}